# Used at build time; set this to a tagged release or commit for repeatable images.
NEURAI_REF=1.0.6

# These settings are written only if the named volume does not already contain
# neurai.conf. Edit the persisted neurai.conf to change an existing node.
NEURAI_P2P_PORT=19000
NEURAI_RPC_PORT=19001
NEURAI_RPC_BIND=127.0.0.1
NEURAI_RPC_ALLOW_IP=127.0.0.1
NEURAI_RPC_THREADS=4
NEURAI_RPC_WORK_QUEUE=16

# Wallet support is enabled by default. Keep private keys out of .env; use the
# wallet RPC, import methods, or the persisted wallet file instead.
NEURAI_DISABLE_WALLET=0
NEURAI_WALLET_FILE=
NEURAI_WALLET_BROADCAST=1
NEURAI_WALLET_RBF=0

# Enabling or disabling indexes after initial sync requires rebuilding data:
# assetindex requires -reindex; address/spent/timestamp indexes require
# -reindex-chainstate. Do not use pruning with txindex.
NEURAI_TXINDEX=0
NEURAI_ASSETINDEX=0
NEURAI_ADDRESSINDEX=0
NEURAI_TIMESTAMPINDEX=0
NEURAI_SPENTINDEX=0
NEURAI_REST=0
NEURAI_PRUNE=0
NEURAI_MAX_CONNECTIONS=125
NEURAI_DB_CACHE=450
NEURAI_SCRIPT_THREADS=0
NEURAI_MAX_MEMPOOL=300
NEURAI_PERSIST_MEMPOOL=1

# Leave both empty to use cookie authentication inside the container.
NEURAI_RPC_USER=
NEURAI_RPC_PASSWORD=

# ZMQ remains disabled while these values are empty. For a service in the same
# Compose network, for example: tcp://0.0.0.0:28332.
NEURAI_ZMQ_PUB_HASH_BLOCK=
NEURAI_ZMQ_PUB_HASH_TX=
NEURAI_ZMQ_PUB_RAW_BLOCK=
NEURAI_ZMQ_PUB_RAW_TX=
NEURAI_ZMQ_PUB_RAW_MESSAGE=
