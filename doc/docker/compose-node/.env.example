# Used at build time; set this to a tagged release or commit for repeatable images.
NEURAI_REF=1.0.6

# These settings are written only if the named volume does not already contain
# neurai.conf. Edit the persisted neurai.conf to change an existing node.
NEURAI_TXINDEX=0
NEURAI_ASSETINDEX=0
NEURAI_ADDRESSINDEX=0
NEURAI_TIMESTAMPINDEX=0
NEURAI_REST=0
NEURAI_PRUNE=0
NEURAI_MAX_CONNECTIONS=125

# Leave both empty to use cookie authentication inside the container.
NEURAI_RPC_USER=
NEURAI_RPC_PASSWORD=

# ZMQ remains disabled while these values are empty. For a service in the same
# Compose network, for example: tcp://0.0.0.0:28332.
NEURAI_ZMQ_PUB_HASH_BLOCK=
NEURAI_ZMQ_PUB_HASH_TX=
NEURAI_ZMQ_PUB_RAW_BLOCK=
NEURAI_ZMQ_PUB_RAW_TX=
NEURAI_ZMQ_PUB_RAW_MESSAGE=
