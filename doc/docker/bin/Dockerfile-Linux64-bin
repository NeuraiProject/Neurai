# Build the local source tree into Linux x86_64 Qt binaries.
# Export with: docker build -f doc/docker/bin/Dockerfile-Linux64-bin \
#   --target artifacts --output type=local,dest=build-out/linux64 .

FROM debian:11 AS build

LABEL maintainer="Asimov"
LABEL description="Neurai Linux x86_64 Qt build"

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends git unzip wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root/Neurai
COPY . .

RUN scripts/00-install-deps.sh linux

WORKDIR /root/Neurai/depends
RUN make HOST=x86_64-pc-linux-gnu -j2

WORKDIR /root/Neurai
RUN ./autogen.sh
RUN CONFIG_SITE=$PWD/depends/x86_64-pc-linux-gnu/share/config.site ./configure \
    --prefix=$PWD/depends/x86_64-pc-linux-gnu \
    --enable-cxx --disable-shared --disable-tests --disable-bench --disable-gui-tests \
    --with-gui=qt5 --with-qtdbus=no --with-pic
RUN make -j2

FROM scratch AS artifacts
COPY --from=build /root/Neurai/src/neuraid /neuraid
COPY --from=build /root/Neurai/src/neurai-cli /neurai-cli
COPY --from=build /root/Neurai/src/qt/neurai-qt /neurai-qt
